<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphapulse.update-retry</string>

    <!-- 19:00 晚间流水线（2026-07-12 用户要求由22:00提前）：15:30 时 baostock 未发布
         当日K线，下午选股永远基于 T-1；晚间数据齐后重跑选股+追踪，推送"晚间版"。
         风险提示：baostock 当日K线发布约在 18:00-19:00，19:00 整偶有未出——届时
         断点语义会让本次快速空转（latest=T-1 全部已最新），晚间版≈下午版重播；
         若观察到经常踩空可回调 19:30/20:00。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/run_with_timeout.py</string>
        <string>3000</string>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/eod_pipeline.py</string>
        <string>--max-update-min</string>
        <string>40</string>
        <string>--push-label</string>
        <string>晚间版</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/qiushixuan</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/qiushixuan/cc/quantan trade</string>

    <key>StandardOutPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/update_retry_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/update_retry_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
