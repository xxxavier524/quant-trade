<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphapulse.full-download</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/download_a_share_data.py</string>
        <string>--output-dir</string>
        <string>/Users/qiushixuan/cc/quantan trade/data/day</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/qiushixuan</string>
        <!-- 2026-07-13 修复：删除外接盘 ALPHAPULSE_DATA_DIR 覆盖。
             settings.py 2026-07-04 已迁回内置盘 data/day，此处残留导致
             定时任务写外接盘而流水线读内置盘 → “数据不更新”。 -->
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/qiushixuan/cc/quantan trade</string>

    <key>StandardOutPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/full_download_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/full_download_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
