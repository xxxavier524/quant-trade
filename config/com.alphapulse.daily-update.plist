<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphapulse.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/run_with_timeout.py</string>
        <string>3000</string>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/eod_pipeline.py</string>
        <string>--max-update-min</string>
        <string>30</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/qiushixuan</string>
        <!-- 2026-07-13 修复：删除外接盘 ALPHAPULSE_DATA_DIR 覆盖。
             settings.py 2026-07-04 已迁回内置盘 data/day，此处残留导致
             15:30 定时更新写外接盘而选股/回测读内置盘 → “数据不更新”。 -->
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/qiushixuan/cc/quantan trade</string>

    <key>StandardOutPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/daily_update_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/daily_update_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
