<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphapulse.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/run_with_timeout.py</string>
        <!-- 2026-07-20 加大窗口：全量约5200只顺序取数远超旧30分钟窗口，天天追不平。
             硬超时 3000s(50min)→8400s(140min)；更新步 --max-update-min 30→120。
             15:30 启动，最迟 17:50 前结束，不影响晚间选股/推送。 -->
        <string>8400</string>
        <string>/Users/qiushixuan/cc/quantan trade/.venv/bin/python</string>
        <string>/Users/qiushixuan/cc/quantan trade/scripts/eod_pipeline.py</string>
        <string>--max-update-min</string>
        <string>120</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/qiushixuan</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/qiushixuan/cc/quantan trade</string>

    <key>StandardOutPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/daily_update_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qiushixuan/cc/quantan trade/logs/daily_update_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
